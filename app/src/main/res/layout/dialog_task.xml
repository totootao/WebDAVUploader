<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_task_name"
        style="@style/SectionLabel" />

    <EditText
        android:id="@+id/etTaskName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:hint="@string/hint_task_name"
        android:inputType="text"
        android:singleLine="true"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/label_local_dir"
        style="@style/SectionLabel" />

    <Button
        android:id="@+id/btnPickDir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_outline"
        android:minHeight="42dp"
        android:text="@string/btn_pick_dir"
        android:textColor="@color/primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvDirPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/no_dir_selected"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/label_remote_path"
        style="@style/SectionLabel" />

    <EditText
        android:id="@+id/etRemotePath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:hint="@string/hint_remote_path"
        android:inputType="textUri"
        android:singleLine="true"
        android:textSize="14sp" />
</LinearLayout>
